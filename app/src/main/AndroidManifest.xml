<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network is dormant in local mode and used only after the learner selects an API provider. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11+ package visibility for installed offline TTS/recognition engines. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".Leap8Application"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Leap8"
        android:usesCleartextTraffic="false">
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".ai.LocalAiProcessService"
            android:exported="false"
            android:process=":leap8_cpu"
            android:stopWithTask="true" />
        <service
            android:name=".ai.LocalAiGpuProcessService"
            android:exported="false"
            android:process=":leap8_gpu"
            android:stopWithTask="true" />
        <service
            android:name=".ai.LocalAiNpuProcessService"
            android:exported="false"
            android:process=":leap8_npu"
            android:stopWithTask="true" />
        <service
            android:name=".speech.NaturalVoiceProcessService"
            android:exported="false"
            android:process=":leap8_speech"
            android:stopWithTask="true" />
    </application>
</manifest>
